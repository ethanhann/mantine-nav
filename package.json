{
	"name": "@ethanhann/mantine-nav",
	"version": "0.6.0",
	"description": "A React navigation component library built on Mantine v9",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"engines": {
		"node": ">=v24"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"dev": "storybook dev -p 6006",
		"build": "vite build",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"lint:package": "publint --strict",
		"check:exports": "attw --pack . --profile esm-only",
		"storybook:build": "storybook build",
		"prepublishOnly": "npm run typecheck && npm run test:run && npm run build && npm run lint:package && npm run check:exports"
	},
	"peerDependencies": {
		"@mantine/core": "^9.0.0",
		"@mantine/hooks": "^9.0.0",
		"@mantine/spotlight": "^9.0.0",
		"@tabler/icons-react": "^3.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.3",
		"@axe-core/react": "^4.11.1",
		"@biomejs/biome": "2.4.10",
		"@mantine/code-highlight": "^9.0.0",
		"@mantine/core": "^9.0.0",
		"@mantine/hooks": "^9.0.0",
		"@mantine/spotlight": "^9.3.0",
		"@microsoft/api-extractor": "^7.58.9",
		"@storybook/addon-a11y": "^10.4.2",
		"@storybook/addon-docs": "^10.4.2",
		"@storybook/react-vite": "^10.4.2",
		"@tabler/icons-react": "^3.41.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/bun": "^1.3.11",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/coverage-v8": "^4.1.2",
		"highlight.js": "^11.11.1",
		"jsdom": "^29.0.1",
		"postcss": "^8.5.15",
		"postcss-preset-mantine": "^1.18.0",
		"publint": "^0.3.21",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"rollup-preserve-directives": "^1.1.3",
		"storybook": "^10.4.2",
		"typescript": "^6.0.2",
		"unplugin-dts": "^1.0.2",
		"vite": "^8.0.16",
		"vitest": "^4.1.2",
		"vitest-axe": "^0.1.0",
		"vitest-canvas-mock": "^1.1.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ethanhann/mantine-nav.git"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org"
	},
	"license": "MIT"
}
